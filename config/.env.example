# Azure AD App Registration Environment Variables (Example Template)
AZ_TENANT_ID=YOUR_AZURE_TENANT_ID_HERE
AZ_CLIENT_ID=YOUR_AZURE_CLIENT_ID_HERE
AZ_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET_HERE
AZ_USER_PRINCIPAL_NAME=admin@yourdomain.onmicrosoft.com

# Microsoft Teams / Planner IDs (Optional)
TEAM_ID=YOUR_TEAMS_TEAM_ID
CHANNEL_ID=YOUR_TEAMS_CHANNEL_ID
PLANNER_PLAN_ID=YOUR_PLANNER_PLAN_ID
PLANNER_BUCKET_ID=YOUR_PLANNER_BUCKET_ID
